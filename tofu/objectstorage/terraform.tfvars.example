# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored; this example is
# not, because it holds no values.
#
# The key itself is read from the [d3strukt0r-hetzner] profile in ~/.aws/credentials,
# the one the backends use - see locals.tf.

# The number in the Hetzner Cloud console URL: console.hetzner.com/projects/<id>/...
project_id = ""

# The access key IDs (not the secrets) of the cluster's keys - the "username" field of their
# 1Password items. A mistyped one only shuts that key out of its own bucket.
etcd_access_key_id              = ""
loki_access_key_id              = ""
mariadb_backups_access_key_id   = ""
postgres_backups_access_key_id  = ""
openbao_snapshots_access_key_id = ""
